# TLS is automatic here: Caddy obtains and renews the certificate on first
# request, so there is no certbot cron to forget.
#
# Prerequisite: api.tenmaypcba.com and rt.tenmaypcba.com must both resolve to the
# VPS before the first start, otherwise the ACME challenge fails.

api.tenmaypcba.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8787
}

rt.tenmaypcba.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8787 {
		# Server-Sent Events must not be buffered, or the console sees nothing
		# until the connection closes.
		flush_interval -1
	}
}
